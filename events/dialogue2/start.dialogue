- Trader (easiest)
	do Game.inventory.add( Items.GOLD, 10 )
	do Game.inventory.add( Items.FOOD, 12 )
	do Game.inventory.add( Items.MEDICINE, 2 )

do EventManager.request_input("Survivor", "", "Survivor")
One last thing, say.. what is your name?

set Game.player.info.name = EventManager.temp.input_result
set Game.GameScreen.get_node("%CharacterCard/%NameLabel").text = Game.player.info.name
