	#	#force you to pay an additional tax (-2 gold)
	#	do Game.skip_hour()
	#	do Game.inventory.remove(Items.GOLD, 1)
	#	do Game.player.apply_stat(Stat.HEALTH, -15)

- Find a different path
	Ignoring their demands, you veer off the path into the brush and away from the soldiers.

=> END


~ fight
set temp["char"] = CharGen.generate_character_from_id( "soldier", 1 )
do temp.char.name = "Guard"
do temp.char.inventory.set_slot_config_from("human_config")
do temp.char.inventory.equip_all()
do CombatManager.start( temp.char )
_ #
=> END