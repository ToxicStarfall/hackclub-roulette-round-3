[sub_resource type="Resource" id="Resource_s6awe"]
script = ExtResource("4_hn5tw")
description = "Taking a short stop, you notice the wind picking up, and the sand slowly rises with it. You are in a very dry and sandy area.
In the distance, you see dark, sweeping clouds, swathing the land before you in darkness.

A Sandstorm is approaching!

You do not know how long it will last.

What will you do?"
options = Array[ExtResource("2_rvlvm")]([SubResource("Resource_kmw8u"), SubResource("Resource_ughkx")])
metadata/_custom_type_script = "uid://dk7vmirn2sppi"

