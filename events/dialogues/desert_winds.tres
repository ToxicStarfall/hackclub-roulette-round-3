[sub_resource type="Resource" id="Resource_hn5tw"]
script = ExtResource("4_hn5tw")
description = "The sandstorm lasts longer than you anticipated, the sand particles having worn away at you skin, leaving you with many cuts.
The sandstorm has really hurt you."
options = Array[ExtResource("2_rvlvm")]([])
metadata/_custom_type_script = "uid://dk7vmirn2sppi"

[sub_resource type="Resource" id="Resource_fepuc"]
script = ExtResource("4_hn5tw")
description = "Luckily, the sandstorm passed quickly, and you emerge covered in sand, but unharmed."
options = Array[ExtResource("2_rvlvm")]([])
metadata/_custom_type_script = "uid://dk7vmirn2sppi"

