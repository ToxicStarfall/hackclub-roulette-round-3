[sub_resource type="Resource" id="Resource_rmjqm"]
script = ExtResource("1_rmjqm")
description = "Survivor, your end has not yet arrived. 

In the face of this madness, you must continue to persevere.
Ahead of you lies many challenges and difficult choices but your future is still uncertain at this time. However, hidden past the murky depths of this blight is salvation.

This is the beginning of your journey, Survivor.

[right][i]Click to continue...[/i][/right]"
metadata/_custom_type_script = "uid://dk7vmirn2sppi"

