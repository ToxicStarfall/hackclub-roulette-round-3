[sub_resource type="Resource" id="Resource_ktac5"]
script = ExtResource("2_yn44i")
description = "A dirty and dishelved beggar approches you, carying with him a small rucksack.
He looks hopeful."
options = Array[ExtResource("1_jvdr7")]([])
metadata/_custom_type_script = "uid://dk7vmirn2sppi"

[sub_resource type="Resource" id="Resource_bu2sv"]
script = ExtResource("2_yn44i")
description = "You give the beggar some gold, and he thanks you, with much gratitude and happiness, bidding you farewell."
options = Array[ExtResource("1_jvdr7")]([])
metadata/_custom_type_script = "uid://dk7vmirn2sppi"

